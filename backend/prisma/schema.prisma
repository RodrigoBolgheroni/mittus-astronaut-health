generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model CheckIn {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId         String   @map("session_id") @db.Uuid
  checkInDate       DateTime @map("check_in_date") @db.Date
  sleepHours        Decimal  @map("sleep_hours") @db.Decimal(4, 2)
  stressLevel       Int      @map("stress_level") @db.SmallInt
  moodLevel         Int      @map("mood_level") @db.SmallInt
  teamConflictLevel Int      @map("team_conflict_level") @db.SmallInt
  fatigue           Int      @db.SmallInt
  description       String?  @db.Text
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  stressOption       StressLevelOption       @relation(fields: [stressLevel], references: [value], onDelete: NoAction, onUpdate: NoAction, map: "check_ins_stress_level_fk")
  moodOption         MoodLevelOption         @relation(fields: [moodLevel], references: [value], onDelete: NoAction, onUpdate: NoAction, map: "check_ins_mood_level_fk")
  teamConflictOption TeamConflictLevelOption @relation(fields: [teamConflictLevel], references: [value], onDelete: NoAction, onUpdate: NoAction, map: "check_ins_team_conflict_level_fk")
  fatigueOption      FatigueOption           @relation(fields: [fatigue], references: [value], onDelete: NoAction, onUpdate: NoAction, map: "check_ins_fatigue_fk")
  actions            CheckInAction[]
  insights           CheckInInsight[]

  @@unique([sessionId, checkInDate], map: "check_ins_session_date_unique")
  @@map("check_ins")
}

model StressLevelOption {
  value    Int       @id @db.SmallInt
  label    String    @unique(map: "stress_level_options_label_key") @db.Text
  checkIns CheckIn[]

  @@map("stress_level_options")
}

model MoodLevelOption {
  value    Int       @id @db.SmallInt
  label    String    @unique(map: "mood_level_options_label_key") @db.Text
  checkIns CheckIn[]

  @@map("mood_level_options")
}

model TeamConflictLevelOption {
  value    Int       @id @db.SmallInt
  label    String    @unique(map: "team_conflict_level_options_label_key") @db.Text
  checkIns CheckIn[]

  @@map("team_conflict_level_options")
}

model FatigueOption {
  value    Int       @id @db.SmallInt
  label    String    @unique(map: "fatigue_options_label_key") @db.Text
  checkIns CheckIn[]

  @@map("fatigue_options")
}

model CheckInAction {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  checkInId        String    @map("check_in_id") @db.Uuid
  evaluationKey    String    @map("evaluation_key") @db.Text
  taskKey          String    @map("task_key") @db.Text
  title            String    @db.Text
  source           String    @db.Text
  kind             String    @default("task") @db.Text
  actionCode       String    @map("action_code") @db.Text
  reasonCode       String    @map("reason_code") @db.Text
  rulesetVersion   String    @map("ruleset_version") @db.Text
  forecastSnapshot Json?     @map("forecast_snapshot") @db.JsonB
  status           String    @default("suggested") @db.Text
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  acknowledgedAt   DateTime? @map("acknowledged_at") @db.Timestamptz(6)
  resolvedAt       DateTime? @map("resolved_at") @db.Timestamptz(6)

  checkIn CheckIn @relation(fields: [checkInId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "check_in_actions_check_in_id_fkey")

  @@unique([checkInId, evaluationKey, taskKey], map: "check_in_actions_evaluation_task_key")
  @@index([checkInId, createdAt(sort: Desc)], map: "check_in_actions_check_in_created_idx")
  @@map("check_in_actions")
}

model CheckInInsight {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  checkInId     String    @map("check_in_id") @db.Uuid
  evaluationKey String    @map("evaluation_key") @db.Text
  title         String    @db.Text
  summary       String    @db.Text
  nextStep      String    @map("next_step") @db.Text
  facts         Json      @db.JsonB
  source        String    @db.Text
  generator     String?   @db.Text
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  supersededAt  DateTime? @map("superseded_at") @db.Timestamptz(6)

  checkIn CheckIn @relation(fields: [checkInId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "check_in_insights_check_in_id_fkey")

  @@unique([checkInId, evaluationKey], map: "check_in_insights_evaluation_key")
  @@index([checkInId, createdAt(sort: Desc)], map: "check_in_insights_check_in_created_idx")
  // The partial unique check_in_insights_current_idx remains SQL-only.
  @@map("check_in_insights")
}

model MissionPlace {
  id            String    @id(map: "mission_places_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code          String    @unique(map: "mission_places_code_key") @db.Text
  name          String    @db.Text
  label         String    @db.Text
  kind          String    @db.Text
  trackedObject String?   @map("tracked_object") @db.Text
  latitude      Float?    @db.DoublePrecision
  longitude     Float?    @db.DoublePrecision
  source        String?   @db.Text
  simulated     Boolean   @default(false)
  sourceUrl     String?   @map("source_url") @db.Text
  fetchedAt     DateTime? @map("fetched_at") @db.Timestamptz(6)

  departureLegs   MissionLeg[] @relation("MissionLegDeparture")
  destinationLegs MissionLeg[] @relation("MissionLegDestination")

  @@map("mission_places")
}

model Mission {
  id             String   @id(map: "missions_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code           String   @unique(map: "missions_code_key") @db.Text
  name           String   @db.Text
  isDemo         Boolean  @default(false) @map("is_demo")
  ll2LaunchId    String?  @map("ll2_launch_id") @db.Uuid
  noradId        Int?     @map("norad_id") @db.Integer
  referenceLabel String?  @map("reference_label") @db.Text
  referenceUrl   String?  @map("reference_url") @db.Text
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  legs            MissionLeg[]
  sessionMissions SessionMission[]

  // The partial unique missions_single_demo_idx remains SQL-only in migration 20261114220000_create_missions.
  @@map("missions")
}

model MissionLeg {
  missionId              String    @map("mission_id") @db.Uuid
  phase                  String    @db.Text
  departurePlaceId       String    @map("departure_place_id") @db.Uuid
  departureAt            DateTime? @map("departure_at") @db.Timestamptz(6)
  departureAtSource      String?   @map("departure_at_source") @db.Text
  destinationPlaceId     String    @map("destination_place_id") @db.Uuid
  destinationDescription String    @map("destination_description") @db.Text

  mission          Mission      @relation(fields: [missionId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "mission_legs_mission_id_fkey")
  departurePlace   MissionPlace @relation("MissionLegDeparture", fields: [departurePlaceId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "mission_legs_departure_place_id_fkey")
  destinationPlace MissionPlace @relation("MissionLegDestination", fields: [destinationPlaceId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "mission_legs_destination_place_id_fkey")

  @@id([missionId, phase], map: "mission_legs_pkey")
  @@index([departurePlaceId], map: "mission_legs_departure_place_idx")
  @@index([destinationPlaceId], map: "mission_legs_destination_place_idx")
  @@map("mission_legs")
}

model SessionMission {
  sessionId String   @id(map: "session_missions_pkey") @map("session_id") @db.Uuid
  missionId String   @map("mission_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  mission Mission @relation(fields: [missionId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "session_missions_mission_id_fkey")

  @@index([missionId], map: "session_missions_mission_idx")
  @@map("session_missions")
}
